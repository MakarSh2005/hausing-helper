# Настройки «Жилищного помощника». Скопируйте в .env (cp .env.example .env) и заполните.
# .env не коммитится: в нём токен. Реальные значения — только на служебном слайде презентации.
# Полное описание каждой переменной — README, раздел 6.

# ═══ ОБЯЗАТЕЛЬНО ═══════════════════════════════════════════════════════════
# Токен бота MAX — сразу после знака =, без пробелов и кавычек.
MAX_BOT_TOKEN=

# ═══ РЕЖИМ РАБОТЫ ══════════════════════════════════════════════════════════
# polling — запуск на своём компьютере: бот сам забирает сообщения у MAX,
#           не нужны ни домен, ни HTTPS, ни секрет вебхука.
# webhook — запуск на сервере с HTTPS: MAX присылает сообщения на PUBLIC_BASE_URL/webhook.
MAX_MODE=polling

# ═══ ТОЛЬКО ДЛЯ РЕЖИМА webhook ═════════════════════════════════════════════
# Секрет вебхука: 5–256 символов, латиница, цифры, дефис. Генерация: openssl rand -hex 24
MAX_WEBHOOK_SECRET=
# Публичный HTTPS-адрес сервера (на него регистрируется вебхук; из него же ссылки на мини-приложение)
PUBLIC_BASE_URL=
# true — бот сам оформит подписку на вебхук при старте (хостинг без консоли)
MAX_AUTO_SUBSCRIBE=false

# ═══ МИНИ-ПРИЛОЖЕНИЕ ═══════════════════════════════════════════════════════
# open_app — кнопка MAX запускает мини-приложение внутри MAX (адрес привязан к боту на платформе MAX);
# link — ссылка со входом, откроется в браузере.
MINIAPP_BUTTON=open_app
# Ключ подписи сессий (не короче 32 символов). Пусто — производится из токена бота. Генерация: openssl rand -hex 32
SESSION_JWT_SECRET=
SESSION_TTL_SECONDS=3600

# ═══ ДАННЫЕ ════════════════════════════════════════════════════════════════
# Для запуска без Docker: файл backend/prisma/dev.db. В Docker переопределяется на file:/data/app.db.
DATABASE_URL=file:./dev.db
# Папка для фото заявок (в Docker — /data)
DATA_DIR=./data

# ═══ СЕРВЕР ════════════════════════════════════════════════════════════════
PORT=3000
# development — цветные читаемые логи; в Docker всегда production
NODE_ENV=development
LOG_LEVEL=info
# Логировать сырые события MAX — только для сверки формата, потом выключить (в них тексты пользователей)
LOG_RAW_UPDATES=false

# ═══ ДЕМО-РЕЖИМ ════════════════════════════════════════════════════════════
# Статус заявки меняется по времени с пометкой «демо»: через 30 с «принята», через 5 мин «в работе»
MOCK_AUTO_STATUS_CHANGE=true
# Напоминание о заявке через N минут вместо нормативного срока — чтобы увидеть сценарий просрочки.
# Сам срок в заявке остаётся нормативным. Пусто — напоминание строго по сроку.
DEMO_DUE_MINUTES=

# ═══ ПОРТ НА КОМПЬЮТЕРЕ (docker compose) ══════════════════════════════════
BACKEND_PORT=3000
