# Настройки бота. Копия этого файла с именем .env создаётся командой подготовки проекта.
# .env не коммитится: в нём токен. Реальные значения — только на служебном слайде презентации.

# ═══ ЗАПОЛНИТЬ ОБЯЗАТЕЛЬНО ═════════════════════════════════════════════════
# Токен бота — вставьте сразу после знака =, без пробелов и кавычек.
MAX_BOT_TOKEN=

# ═══ РЕЖИМ РАБОТЫ ══════════════════════════════════════════════════════════
# polling — запуск на своём компьютере: бот сам забирает сообщения у MAX,
#           не нужны ни домен, ни HTTPS, ни секрет вебхука.
# webhook — запуск на сервере с HTTPS: MAX присылает сообщения на PUBLIC_BASE_URL/webhook.
MAX_MODE=polling

# ═══ ТОЛЬКО ДЛЯ РЕЖИМА webhook ═════════════════════════════════════════════
# Секрет вебхука: 5-256 символов, латиница, цифры, дефис. Генерация: openssl rand -hex 24
MAX_WEBHOOK_SECRET=
# Публичный HTTPS-адрес бэкенда, на него регистрируется подписка
PUBLIC_BASE_URL=
# true — бот сам оформит подписку на вебхук при старте
MAX_AUTO_SUBSCRIBE=false

# ═══ МИНИ-ПРИЛОЖЕНИЕ (этапы 6–8) ═══════════════════════════════════════════
# Публичный HTTPS-адрес мини-приложения (он же origin для CORS)
MAX_APP_URL=
# Генерация: openssl rand -hex 32
SESSION_JWT_SECRET=
SESSION_TTL_SECONDS=3600

# ═══ БАЗА ДАННЫХ ═══════════════════════════════════════════════════════════
# Для запуска на компьютере: файл backend/prisma/dev.db.
# В Docker и на хостинге переопределяется на file:/app/data/app.db или file:/data/app.db.
DATABASE_URL=file:./dev.db

# ═══ СЕРВЕР ════════════════════════════════════════════════════════════════
PORT=3000
# development — цветные читаемые логи; в Docker всегда production
NODE_ENV=development
LOG_LEVEL=info
# Логировать сырые события MAX — только для сверки формата, потом выключить
LOG_RAW_UPDATES=false

# ═══ ДЕМО-РЕЖИМ ════════════════════════════════════════════════════════════
# Статусы заявки меняются по времени: через 30 с «принята», через 5 мин «в работе» (помечаются «демо»)
MOCK_AUTO_STATUS_CHANGE=true
# Напомнить о заявке через N минут, а не по нормативному сроку — чтобы жюри увидело сценарий просрочки.
# Сам срок в заявке остаётся нормативным. Пусто — напоминание строго по сроку.
DEMO_DUE_MINUTES=
DEMO_ADMIN_TOKEN=

# ═══ ПОРТ НА КОМПЬЮТЕРЕ (docker compose) ══════════════════════════════════
BACKEND_PORT=3000
