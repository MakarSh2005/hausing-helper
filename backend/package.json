{
  "name": "housing-helper-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Жилищный помощник — бот для MAX (бэкенд)",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "setup": "npm run env:init && npm install && npm run db:generate && npm run db:deploy && npm run db:seed",
    "env:init": "node scripts/init-env.mjs",
    "dev": "node --env-file=../.env --watch --import tsx src/index.ts",
    "start:local": "node --env-file=../.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prisma": "node --env-file=../.env node_modules/prisma/build/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "npm run prisma -- migrate dev",
    "db:deploy": "npm run prisma -- migrate deploy",
    "db:seed": "node --env-file=../.env --import tsx prisma/seed.ts",
    "db:reset": "npm run prisma -- migrate reset --force --skip-seed && npm run db:seed",
    "db:check": "npm run prisma -- migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url file:./shadow.db --exit-code",
    "subscribe": "node --env-file=../.env --import tsx scripts/subscribe.ts",
    "subscriptions": "node --env-file=../.env --import tsx scripts/subscribe.ts --list",
    "unsubscribe": "node --env-file=../.env --import tsx scripts/subscribe.ts --delete"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "undici": "^6.28.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "pino-pretty": "^13.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
